[Unit]
Description=Linux Hello diagnostic service (authentication unavailable)
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.linuxhello.Daemon1
ExecStart=/usr/libexec/hello-daemon
Environment=TOKIO_WORKER_THREADS=2
User=linux-hello
Group=linux-hello
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=128
TasksMax=32
MemoryMax=128M
CPUQuota=20%
StandardOutput=journal
StandardError=journal

# Intentionally no [Install] section. Administrators may start this diagnostic
# service explicitly. Installation does not enable it or activate authentication.
