import { Button, ComboBox, GroupBox, HorizontalBox, VerticalBox, TabWidget, TextEdit, LineEdit, SpinBox, CheckBox, ScrollView, Palette } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    title: "Linux Hello";
    preferred-width: 980px;
    preferred-height: 740px;
    min-width: 760px;
    min-height: 660px;
    background: Palette.background;

    in property <[string]> devices;
    in-out property <int> selected-device: 0;
    in-out property <int> timeout-seconds: 10;
    in-out property <bool> session-bus: false;
    in-out property <int> page: 0;
    in property <bool> preview-running: false;
    in-out property <bool> use-ir-emitter: false;
    in property <bool> refreshing: false;
    in property <image> preview-image;
    in property <string> camera-message: "Camera is off. Select Refresh to discover devices.";
    in property <string> daemon-message: "Daemon not queried";
    in property <string> diagnostics: "Refresh to read local device and service diagnostics.";
    in property <string> preview-message: "No frames are recorded. Preview ends automatically.";
    in property <bool> face-check-available: false;
    in property <bool> face-check-running: false;
    in-out property <string> models-directory;
    in-out property <string> recognition-threshold: "0.80";
    in property <string> trial-message: "No manual recognition trials yet.";
    callback test-saved-person();
    callback test-other-person();
    callback clear-trials();
    in property <string> face-check-message: "Face check requires the optional diagnostic build and local models.";
    in property <bool> reference-present: false;
    in property <bool> template-present: false;
    in property <bool> reference-io-running: false;
    in-out property <string> person-name;
    in property <string> active-person-name: "Zapisana osoba";
    in property <bool> enrollment-active: false;
    in property <string> sample-instruction: "Spójrz prosto w kamerę i zatrzymaj głowę.";
    in property <int> recognition-state: 0;
    in property <string> recognition-title: "Gotowe do rozpoznawania";
    in property <bool> person-needs-name: false;
    in property <bool> scan-frame-available: false;
    property <bool> scanning: face-check-running && !reference-io-running;
    callback scan-person();
    callback begin-person();
    callback cancel-person();
    callback rename-person();
    in property <int> sample-count: 0;
    in property <int> sample-target: 8;
    in-out property <string> reference-password;
    in-out property <string> reference-password-confirm;
    in property <string> storage-message: "Dodaj osobę i ukończ osiem ujęć, a następnie zapisz ją tutaj.";
    callback add-sample();
    callback save-reference();
    callback load-reference();
    callback delete-reference();
    callback remember-face();
    callback forget-face();
    callback check-face();
    callback compare-three();
    callback recognize-face();
    callback test-motion();
    callback refresh();
    callback start-preview();
    callback stop-preview();

    VerticalBox {
        padding: 24px;
        spacing: 16px;
        HorizontalBox {
            VerticalBox {
                padding: 0;
                Text { text: "Linux Hello"; font-size: 30px; font-weight: 700; color: Palette.foreground; }
                Text { text: "Twoja zapisana osoba. Wszystko lokalnie."; color: Palette.foreground; }
            }
            Button { width: 120px; height: 40px; text: root.refreshing ? "Odświeżam…" : "Odśwież"; enabled: !root.refreshing && !root.preview-running && !root.face-check-running; clicked => { root.refresh(); } }
        }
        Rectangle {
            height: 48px;
            border-radius: 8px;
            background: #f9e8c6;
            Text { x: 16px; width: parent.width - 32px; height: parent.height; vertical-alignment: center; wrap: word-wrap; color: #513b12; text: "Tryb eksperymentalny · Rozpoznawanie lokalne. Logowanie systemowe jest wyłączone."; }
        }
        TabWidget {
            current-index <=> root.page;
            Tab {
                title: "Przegląd";
                VerticalBox {
                    spacing: 18px;
                    GroupBox { title: "Authentication"; VerticalBox {
                        Text { text: "Face enrollment and login: unavailable"; color: Palette.foreground; }
                        Text { text: "PAM module: not implemented · No integration enabled by this application"; color: Palette.foreground; wrap: word-wrap; }
                    } }
                    GroupBox { title: "Camera"; VerticalBox {
                        Text { text: root.camera-message; color: Palette.foreground; wrap: word-wrap; }
                        Text { text: "IR format hints do not establish liveness or device trust."; color: Palette.foreground; wrap: word-wrap; }
                    } }
                    GroupBox { title: "Local service"; Text { text: root.daemon-message; color: Palette.foreground; wrap: word-wrap; } }
                    Text { text: "Use Camera to check your hardware. Your existing password authentication remains available."; wrap: word-wrap; color: Palette.foreground; }
                }
            }
            Tab {
                title: "Osoba";
                ScrollView {
                    content-width: self.width;
                    content-height: scanner-content.preferred-height;
                    scanner-content := VerticalBox {
                        width: parent.width; height: self.preferred-height;
                        spacing: 10px;
                        HorizontalBox {
                            ComboBox { model: root.devices; current-index <=> root.selected-device; enabled: !root.preview-running && !root.face-check-running && !root.enrollment-active; horizontal-stretch: 1; }
                            CheckBox { text: "IR"; checked <=> root.use-ir-emitter; enabled: !root.preview-running && !root.face-check-running && !root.enrollment-active; }
                            Button { text: "Stop"; enabled: root.preview-running || (root.face-check-running && !root.reference-io-running); clicked => { root.stop-preview(); } }
                        }
                        HorizontalBox {
                            Text { text: root.enrollment-active || !root.template-present ? "1  SKANUJ" : "1  ZESKANOWANO"; color: root.enrollment-active || !root.template-present ? #3d70dc : Palette.foreground; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: root.person-needs-name ? "2  PODPISZ TWARZ" : "2  NADAJ NAZWĘ"; color: root.person-needs-name ? #3d70dc : Palette.foreground; horizontal-stretch: 1; }
                            Text { text: "3  ROZPOZNAJ"; color: root.template-present && !root.person-needs-name && !root.enrollment-active ? #3d70dc : Palette.foreground; horizontal-stretch: 1; }
                        }
                        scan-panel := Rectangle {
                            height: root.height < 700px ? 180px : 220px;
                            border-radius: 16px;
                            background: #101d32;
                            clip: true;
                            Image { source: root.preview-image; width: parent.width; height: parent.height; image-fit: contain; visible: root.scan-frame-available || root.preview-running; }
                            // This oval is a positioning guide, not detected face bounds.
                            face-guide := Rectangle {
                                x: (parent.width - self.width) / 2; y: 16px;
                                height: parent.height - 52px; width: self.height * 0.87; border-radius: self.width / 2;
                                background: transparent;
                                border-width: 2px;
                                border-color: root.recognition-state == 1 ? #66e8ac : #739dff;
                                if !root.scan-frame-available && !root.preview-running: Rectangle {
                                    x: parent.width * 0.29; y: parent.height * 0.18; width: parent.width * 0.38; height: parent.height * 0.4;
                                    border-radius: 30px; border-width: 2px; border-color: #6784ac; background: transparent;
                                }
                                if !root.scan-frame-available && !root.preview-running: Rectangle {
                                    x: parent.width * 0.16; y: parent.height * 0.63; width: parent.width * 0.65; height: parent.height * 0.21;
                                    border-radius: 20px; border-width: 2px; border-color: #6784ac; background: transparent;
                                }
                            }
                            if root.face-check-running && !root.reference-io-running: Rectangle {
                                x: 20px; width: parent.width - 40px; height: 2px;
                                y: 24px + (parent.height - 65px) * mod(animation-tick(), 1600ms) / 1600ms;
                                background: #67b4ff;
                                Rectangle { y: -7px; width: parent.width; height: 16px; background: #3087e520; }
                            }
                            Text {
                                x: 16px; y: parent.height - 30px; width: parent.width - 32px; height: 22px;
                                horizontal-alignment: center; color: #d0e0ff; font-size: 12px;
                                text: root.scanning ? "SKANOWANIE W TOKU  ·  STOP ANULUJE" : root.person-needs-name ? "SKAN GOTOWY  ·  PODPISZ TWARZ PONIŻEJ" : "USTAW TWARZ W RAMCE  ·  OBRAZY NIE SĄ ZAPISYWANE";
                            }
                            if root.recognition-state == 1 && !root.face-check-running: Rectangle {
                                x: parent.width - 50px; y: 16px; width: 32px; height: 32px; border-radius: 16px; background: #2ab47e;
                                Text { text: "✓"; color: white; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        if root.enrollment-active: Rectangle {
                            height: 6px; border-radius: 3px; background: #d6e1f6;
                            Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * root.sample-count / root.sample-target; border-radius: 3px; background: #3d70dc; }
                        }
                        Text {
                            text: root.enrollment-active ? root.sample-instruction + " (" + root.sample-count + "/" + root.sample-target + ")" : root.person-needs-name ? "Jak nazwać tę twarz?" : root.recognition-state > 0 ? root.recognition-title : root.template-present ? "Gotowe do rozpoznawania: " + root.active-person-name : "Zeskanuj twarz, a potem nadaj jej nazwę";
                            font-size: 21px; font-weight: 700; wrap: word-wrap;
                            color: root.recognition-state == 1 ? #188357 : Palette.foreground;
                        }
                        if root.person-needs-name && !root.enrollment-active: HorizontalBox {
                            LineEdit { placeholder-text: "Imię lub nazwa, np. Jan"; text <=> root.person-name; enabled: !root.face-check-running; horizontal-stretch: 1; }
                            Button { text: "Podpisz twarz"; enabled: !root.face-check-running && root.person-name != ""; clicked => { root.rename-person(); } }
                        }
                        if !root.person-needs-name: HorizontalBox {
                            if !root.template-present || root.enrollment-active: Button {
                                text: root.scanning ? "Skanuję…" : root.enrollment-active ? "Kontynuuj skan" : "Skanuj nową twarz";
                                enabled: root.face-check-available && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != "";
                                clicked => { root.scan-person(); }
                            }
                            if root.template-present && !root.enrollment-active: Button {
                                text: root.scanning ? "Rozpoznaję…" : "Skanuj i rozpoznaj";
                                enabled: root.sample-count >= root.sample-target && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != "";
                                clicked => { root.recognize-face(); }
                            }
                            if root.enrollment-active: Button { text: "Anuluj dodawanie"; enabled: !root.face-check-running && !root.preview-running; clicked => { root.cancel-person(); } }
                            if root.template-present && !root.enrollment-active: Button { text: "Dodaj inną twarz"; enabled: !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.scan-person(); } }
                            Button { text: "Zapisz / wczytaj"; enabled: !root.face-check-running && !root.preview-running; clicked => { root.page = 2; } }
                        }
                        if root.recognition-state != 1 && root.recognition-state != 2 && root.recognition-state != 3: Text { text: root.face-check-message; wrap: word-wrap; color: Palette.foreground; font-size: 12px; }
                    }
                }
            }
            Tab {
                title: "Ustawienia";
                ScrollView {
                    content-width: self.width;
                    content-height: settings-content.preferred-height;
                    settings-content := VerticalBox {
                        width: parent.width;
                        height: self.preferred-height;
                    GroupBox { title: "Diagnostic capture"; VerticalBox {
                        HorizontalBox {
                            Text { text: "Preview timeout (seconds)"; color: Palette.foreground; vertical-alignment: center; }
                            SpinBox { minimum: 1; maximum: 30; value <=> root.timeout-seconds; enabled: !root.preview-running && !root.face-check-running; }
                        }
                        Text { text: "Applies to this window only. No camera runs in the background."; color: Palette.foreground; wrap: word-wrap; }
                    } }
                    if root.face-check-available && root.template-present && !root.enrollment-active: GroupBox { title: "Nazwa twarzy"; VerticalBox {
                        Text { text: "Aktywna nazwa: " + root.active-person-name; color: Palette.foreground; wrap: word-wrap; }
                        HorizontalBox {
                            LineEdit { placeholder-text: "Nowa nazwa osoby"; text <=> root.person-name; enabled: !root.face-check-running; horizontal-stretch: 1; }
                            Button { text: "Zmień nazwę"; enabled: !root.face-check-running && !root.preview-running && root.person-name != ""; clicked => { root.rename-person(); } }
                            Button { text: "Usuń z pamięci"; enabled: !root.face-check-running && !root.preview-running; clicked => { root.forget-face(); } }
                        }
                    } }
                    if root.face-check-available: GroupBox { title: "Zapisz / wczytaj osobę"; VerticalBox {
                        Text { text: "Nazwa i próbki zostaną zaszyfrowane razem. Wybierz osobne hasło (co najmniej 12 znaków)."; wrap: word-wrap; color: Palette.foreground; }
                        LineEdit { placeholder-text: "Hasło zapisanej osoby"; input-type: password; text <=> root.reference-password; enabled: !root.face-check-running; }
                        LineEdit { placeholder-text: "Powtórz hasło przy zapisie"; input-type: password; text <=> root.reference-password-confirm; enabled: !root.face-check-running; }
                        HorizontalBox {
                            Button { text: "Zapisz osobę"; enabled: root.template-present && !root.face-check-running && !root.preview-running; clicked => { root.save-reference(); } }
                            Button { text: "Wczytaj osobę"; enabled: !root.face-check-running && !root.preview-running; clicked => { root.load-reference(); } }
                            Button { text: "Usuń zapisany plik"; enabled: !root.face-check-running && !root.preview-running; clicked => { root.delete-reference(); } }
                        }
                        Text { text: root.storage-message; wrap: word-wrap; color: Palette.foreground; }
                        Text { text: "Po ponownym uruchomieniu wpisz hasło w pierwszym polu i wybierz Wczytaj osobę. Zapis nie włącza logowania."; wrap: word-wrap; color: Palette.foreground; }
                    } }
                    if root.face-check-available: GroupBox { title: "Experimental recognition"; VerticalBox {
                        HorizontalBox {
                            Text { text: "Próg podobieństwa (0,80–1,00)"; color: Palette.foreground; }
                            LineEdit { text <=> root.recognition-threshold; enabled: !root.face-check-running; horizontal-stretch: 1; }
                        }
                        Text { text: "Ścisłe rozpoznawanie: cechy każdego ujęcia, wzorzec średni, proporcje twarzy i 5 etapów losowej kontroli ruchu głowy. Próg minimum 0,80. Stary wzorzec wymaga ponownego skanowania. Kontrola ruchu jest eksperymentalna: brak zweryfikowanego PAD i logowania systemowego."; wrap: word-wrap; color: Palette.foreground; }
                    } }
                    if root.face-check-available: GroupBox { title: "Manual recognition trials"; VerticalBox {
                        Text { text: "Select the camera/IR mode in Camera first. Choose Saved person for the reference owner, Other person for someone else with their consent. Each click checks 3 fresh captures."; wrap: word-wrap; color: Palette.foreground; }
                        HorizontalBox {
                            Button { text: "Test saved person"; enabled: root.template-present && root.sample-count >= root.sample-target && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.test-saved-person(); } }
                            Button { text: "Test other person"; enabled: root.template-present && root.sample-count >= root.sample-target && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.test-other-person(); } }
                            Button { text: "Clear trials"; enabled: !root.face-check-running; clicked => { root.clear-trials(); } }
                            Button { text: "Stop"; enabled: root.face-check-running && !root.reference-io-running; clicked => { root.stop-preview(); } }
                        }
                        Text { text: root.trial-message; wrap: word-wrap; color: Palette.foreground; }
                        Text { text: "Counts stay in memory until Clear trials or window close. Labels are declared by you. Inconclusive and acquisition failures stay separate; cancellation is not counted. Clear trials after changing reference or threshold. No calibrated accuracy or login authorization."; wrap: word-wrap; color: Palette.foreground; }
                    } }
                    if root.face-check-available: GroupBox { title: "Diagnostyka kamery i modeli"; VerticalBox {
                        LineEdit { placeholder-text: "Local model directory"; text <=> root.models-directory; enabled: !root.face-check-running && !root.enrollment-active; }
                        HorizontalBox {
                            Button { text: "Check face"; enabled: !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.check-face(); } }
                            Button { text: "Compare 3 samples"; enabled: root.reference-present && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.compare-three(); } }
                            Button { text: "Remember face"; enabled: !root.face-check-running && !root.preview-running && !root.enrollment-active && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.remember-face(); } }
                        }
                        Button { text: "Test ruchu głowy (diagnostyka)"; enabled: root.template-present && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.test-motion(); } }
                    } }
                    CheckBox { text: "Query a development session-bus daemon"; checked <=> root.session-bus; enabled: !root.refreshing; }
                    Text { text: "A session daemon cannot authorize system authentication. Default queries use the system bus."; color: Palette.foreground; wrap: word-wrap; }
                    GroupBox { title: "System integration"; Text { text: "No authentication switches are available in this release. PAM and Polkit login require separate security review and Fedora VM recovery tests."; color: Palette.foreground; wrap: word-wrap; } }
                }
                }
            }
            Tab {
                title: "Bezpieczeństwo";
                VerticalBox {
                    Text { text: "Security capabilities"; font-size: 22px; font-weight: 600; color: Palette.foreground; }
                    Text { text: "Face model: none selected\nPresentation attack detection: unavailable\nInitial Lenovo hardware: not validated\nEncrypted diagnostic reference: optional, passphrase protected\nTPM key protection: not implemented\nPrivileged authentication: unavailable"; color: Palette.foreground; wrap: word-wrap; }
                    Text { text: "No cloud calls, telemetry or frame files are implemented. Diagnostic templates are saved only with Save encrypted. Camera preview stays in this process. Passing software tests does not establish resistance to physical attacks."; color: Palette.foreground; wrap: word-wrap; }
                }
            }
            Tab {
                title: "Diagnostyka";
                VerticalBox {
                    Text { text: "Local device metadata · No image data or templates"; color: Palette.foreground; }
                    TextEdit { text: root.diagnostics; read-only: true; }
                }
            }
        }
        Text { text: "0.1.0-dev  ·  Diagnostic release  ·  Camera access follows your Linux session permissions"; color: Palette.foreground; font-size: 12px; }
    }
}
