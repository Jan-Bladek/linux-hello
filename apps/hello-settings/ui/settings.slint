import { Button, ComboBox, GroupBox, HorizontalBox, VerticalBox, TabWidget, TextEdit, SpinBox, CheckBox, Palette } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    title: "Linux Hello";
    preferred-width: 980px;
    preferred-height: 740px;
    min-width: 760px;
    min-height: 660px;
    background: Palette.background;

    in property <[string]> devices;
    in-out property <int> selected-device: 0;
    in-out property <int> timeout-seconds: 10;
    in-out property <bool> session-bus: false;
    in-out property <int> page: 0;
    in property <bool> preview-running: false;
    in property <bool> refreshing: false;
    in property <image> preview-image;
    in property <string> camera-message: "Camera is off. Select Refresh to discover devices.";
    in property <string> daemon-message: "Daemon not queried";
    in property <string> diagnostics: "Refresh to read local device and service diagnostics.";
    in property <string> preview-message: "No frames are recorded. Preview ends automatically.";
    callback refresh();
    callback start-preview();
    callback stop-preview();

    VerticalBox {
        padding: 24px;
        spacing: 16px;
        HorizontalBox {
            VerticalBox {
                padding: 0;
                Text { text: "Linux Hello"; font-size: 30px; font-weight: 700; color: Palette.foreground; }
                Text { text: "Private by design. Local by default."; color: Palette.foreground; }
            }
            Button { text: root.refreshing ? "Refreshing…" : "Refresh"; enabled: !root.refreshing && !root.preview-running; clicked => { root.refresh(); } }
        }
        Rectangle {
            height: 62px;
            border-radius: 8px;
            background: #f9e8c6;
            Text { x: 16px; width: parent.width - 32px; height: parent.height; vertical-alignment: center; wrap: word-wrap; color: #513b12; text: "DEVELOPMENT PREVIEW · Face authentication is unavailable.\nNo evaluated face model or presentation attack detector is installed."; }
        }
        TabWidget {
            current-index <=> root.page;
            Tab {
                title: "Overview";
                VerticalBox {
                    spacing: 18px;
                    GroupBox { title: "Authentication"; VerticalBox {
                        Text { text: "Face enrollment and login: unavailable"; color: Palette.foreground; }
                        Text { text: "PAM module: not implemented · No integration enabled by this application"; color: Palette.foreground; wrap: word-wrap; }
                    } }
                    GroupBox { title: "Camera"; VerticalBox {
                        Text { text: root.camera-message; color: Palette.foreground; wrap: word-wrap; }
                        Text { text: "IR format hints do not establish liveness or device trust."; color: Palette.foreground; wrap: word-wrap; }
                    } }
                    GroupBox { title: "Local service"; Text { text: root.daemon-message; color: Palette.foreground; wrap: word-wrap; } }
                    Text { text: "Use Camera to check your hardware. Your existing password authentication remains available."; wrap: word-wrap; color: Palette.foreground; }
                }
            }
            Tab {
                title: "Camera";
                VerticalBox {
                    HorizontalBox {
                        ComboBox { model: root.devices; current-index <=> root.selected-device; enabled: !root.preview-running; horizontal-stretch: 1; }
                        Button { text: "Start preview"; enabled: !root.preview-running && !root.refreshing && root.devices.length > 0; clicked => { root.start-preview(); } }
                        Button { text: "Stop"; enabled: root.preview-running; clicked => { root.stop-preview(); } }
                    }
                    Rectangle {
                        min-height: 250px;
                        background: #111820;
                        border-radius: 8px;
                        Image { source: root.preview-image; width: parent.width; height: parent.height; image-fit: contain; }
                        if !root.preview-running: Text { text: "Camera off"; color: #ccd6e0; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: root.preview-message; color: Palette.foreground; wrap: word-wrap; }
                    Text { text: "Enrollment is unavailable until the face model, quality checks, PAD and trusted authorization are integrated and evaluated."; color: Palette.foreground; wrap: word-wrap; }
                }
            }
            Tab {
                title: "Settings";
                VerticalBox {
                    GroupBox { title: "Diagnostic capture"; VerticalBox {
                        HorizontalBox {
                            Text { text: "Preview timeout (seconds)"; color: Palette.foreground; vertical-alignment: center; }
                            SpinBox { minimum: 1; maximum: 30; value <=> root.timeout-seconds; enabled: !root.preview-running; }
                        }
                        Text { text: "Applies to this window only. No camera runs in the background."; color: Palette.foreground; wrap: word-wrap; }
                    } }
                    CheckBox { text: "Query a development session-bus daemon"; checked <=> root.session-bus; enabled: !root.refreshing; }
                    Text { text: "A session daemon cannot authorize system authentication. Default queries use the system bus."; color: Palette.foreground; wrap: word-wrap; }
                    GroupBox { title: "System integration"; Text { text: "No authentication switches are available in this release. PAM and Polkit login require separate security review and Fedora VM recovery tests."; color: Palette.foreground; wrap: word-wrap; } }
                }
            }
            Tab {
                title: "Security";
                VerticalBox {
                    Text { text: "Security capabilities"; font-size: 22px; font-weight: 600; color: Palette.foreground; }
                    Text { text: "Face model: none selected\nPresentation attack detection: unavailable\nInitial Lenovo hardware: not validated\nEncrypted storage: library implemented; not used for enrollment\nTPM key protection: not implemented\nPrivileged authentication: unavailable"; color: Palette.foreground; wrap: word-wrap; }
                    Text { text: "No cloud calls, telemetry or frame files are implemented. Camera preview stays in this process. Passing software tests does not establish resistance to physical attacks."; color: Palette.foreground; wrap: word-wrap; }
                }
            }
            Tab {
                title: "Diagnostics";
                VerticalBox {
                    Text { text: "Local device metadata · No image data or templates"; color: Palette.foreground; }
                    TextEdit { text: root.diagnostics; read-only: true; }
                }
            }
        }
        Text { text: "0.1.0-dev  ·  Diagnostic release  ·  Camera access follows your Linux session permissions"; color: Palette.foreground; font-size: 12px; }
    }
}
