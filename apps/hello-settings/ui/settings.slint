import { Button, ComboBox, GroupBox, HorizontalBox, VerticalBox, TabWidget, TextEdit, LineEdit, SpinBox, CheckBox, ScrollView, Palette } from "std-widgets.slint";

component UseCard inherits Rectangle {
    in-out property <bool> checked;
    in property <string> heading;
    in property <string> description;
    in property <bool> option-enabled: true;
    preferred-height: 106px;
    border-radius: 12px;
    border-width: 1px;
    border-color: checked ? #477be0 : #dce3ef;
    background: Palette.background;
    VerticalBox {
        padding: 14px; spacing: 8px;
        CheckBox { text: root.heading; checked <=> root.checked; enabled: root.option-enabled; }
        Text { text: root.description; wrap: word-wrap; color: Palette.foreground; font-size: 12px; }
    }
}

export component SettingsWindow inherits Window {
    title: "Linux Hello";
    preferred-width: 980px;
    preferred-height: 740px;
    min-width: 760px;
    min-height: 660px;
    background: Palette.background;

    in property <[string]> devices;
    in-out property <int> selected-device: 0;
    in-out property <int> timeout-seconds: 10;
    in-out property <bool> session-bus: false;
    in-out property <int> page: 1;
    in-out property <bool> developer-mode: false;
    in-out property <bool> use-for-sudo: true;
    in-out property <bool> use-for-login: true;
    in-out property <bool> use-for-unlock: true;
    in property <bool> system-configured: false;
    in property <string> account-name: "current user";
    in property <string> system-message: "Choose where to use your face. Saving and setup use one system authorization dialog.";
    in property <bool> system-controls-available: false;
    in property <bool> health-check-available: false;
    in property <string> account-status: "System status has not been checked. Authorize a status check to read your protected account settings.";
    in-out property <bool> confirm-system-removal: false;
    callback refresh-account-status();
    callback pause-account();
    callback remove-account();
    callback run-health-check();
    callback save-and-configure();
    in property <bool> preview-running: false;
    in-out property <bool> use-ir-emitter: false;
    in property <bool> refreshing: false;
    in property <image> preview-image;
    in property <string> camera-message: "Discovering cameras…";
    in property <string> daemon-message: "Daemon not queried";
    in property <string> diagnostics: "Refresh to read local device and service diagnostics.";
    in property <string> preview-message: "No frames are recorded. Preview ends automatically.";
    in property <bool> face-check-available: false;
    in property <bool> face-check-running: false;
    in-out property <string> models-directory;
    in-out property <string> recognition-threshold: "0.80";
    in property <string> trial-message: "No manual recognition trials yet.";
    callback test-saved-person();
    callback test-other-person();
    callback clear-trials();
    in property <string> face-check-message: "Face enrollment requires the full application and installed models.";
    in property <bool> reference-present: false;
    in property <bool> template-present: false;
    in property <bool> reference-io-running: false;
    in-out property <string> person-name;
    in property <string> active-person-name: "Saved person";
    in property <bool> enrollment-active: false;
    in property <string> sample-instruction: "Look straight at the camera and hold still.";
    in property <int> recognition-state: 0;
    in property <string> recognition-title: "Ready to recognize";
    in property <bool> person-needs-name: false;
    in property <bool> scan-frame-available: false;
    property <bool> scanning: face-check-running && !reference-io-running;
    callback scan-person();
    callback begin-person();
    callback cancel-person();
    callback rename-person();
    in property <int> sample-count: 0;
    in property <int> sample-target: 8;
    in-out property <string> reference-password;
    in-out property <string> reference-password-confirm;
    in property <string> storage-message: "Enroll a face with eight accepted samples, then save it here.";
    callback add-sample();
    callback save-reference();
    callback load-reference();
    callback delete-reference();
    callback remember-face();
    callback forget-face();
    callback check-face();
    callback compare-three();
    callback recognize-face();
    callback test-motion();
    callback refresh();
    callback start-preview();
    callback stop-preview();

    VerticalBox {
        padding: 24px;
        spacing: 16px;
        HorizontalBox {
            VerticalBox {
                padding: 0;
                Text { text: "Linux Hello"; font-size: 30px; font-weight: 700; color: Palette.foreground; }
                Text { text: "Face authentication for " + root.account-name + " · On this device"; color: Palette.foreground; }
            }
            Button { width: 120px; height: 40px; text: root.refreshing ? "Refreshing…" : "Refresh"; enabled: !root.refreshing && !root.preview-running && !root.face-check-running; clicked => { root.refresh(); } }
        }
        Rectangle {
            height: 48px;
            border-radius: 8px;
            background: #f9e8c6;
            Text { x: 16px; width: parent.width - 32px; height: parent.height; vertical-alignment: center; wrap: word-wrap; color: #513b12; text: "Experimental biometrics · Password fallback remains available. Photo/video attack protection is not validated."; }
        }
        TabWidget {
            current-index <=> root.page;
            Tab {
                title: "Overview";
                ScrollView {
                    content-width: self.width;
                    content-height: overview-content.preferred-height;
                    overview-content := VerticalBox {
                    width: parent.width; height: self.preferred-height;
                    spacing: 18px;
                    GroupBox { title: "Your face"; VerticalBox {
                        Text { text: root.template-present ? root.active-person-name : "No face enrolled in this application yet"; font-size: 24px; font-weight: 700; color: Palette.foreground; }
                        Text { text: "Scan your face, give it a name, and choose where to use it."; color: Palette.foreground; wrap: word-wrap; }
                        Button { text: root.template-present ? "Open your face" : "Add a face"; clicked => { root.page = 1; } }
                    } }
                    GroupBox { title: "System account"; VerticalBox {
                        Text { text: root.account-status; wrap: word-wrap; color: Palette.foreground; }
                        HorizontalBox {
                            Button { text: "Check system status"; enabled: root.system-controls-available && !root.face-check-running && !root.preview-running; clicked => { root.refresh-account-status(); } }
                            Button { text: "Installation health"; enabled: root.health-check-available && !root.face-check-running && !root.preview-running; clicked => { root.run-health-check(); } }
                        }
                    } }
                    GroupBox { title: "Account setup"; VerticalBox {
                        Text { text: root.system-message; wrap: word-wrap; color: Palette.foreground; }
                        Button { text: "Choose uses"; clicked => { root.page = 2; } }
                    } }
                    GroupBox { title: "Camera"; VerticalBox {
                        Text { text: root.camera-message; color: Palette.foreground; wrap: word-wrap; }
                        if root.developer-mode: Text { text: "An IR label does not prove liveness or that a device is trusted."; color: Palette.foreground; wrap: word-wrap; }
                    } }
                    if root.developer-mode: GroupBox { title: "Diagnostic service"; Text { text: root.daemon-message; color: Palette.foreground; wrap: word-wrap; } }
                }
                }
            }
            Tab {
                title: "Face";
                ScrollView {
                    content-width: self.width;
                    content-height: scanner-content.preferred-height;
                    scanner-content := VerticalBox {
                        width: parent.width; height: self.preferred-height;
                        spacing: 10px;
                        HorizontalBox {
                            ComboBox { model: root.devices; current-index <=> root.selected-device; enabled: !root.preview-running && !root.face-check-running && !root.enrollment-active; horizontal-stretch: 1; }
                            CheckBox { text: "IR illumination"; checked <=> root.use-ir-emitter; enabled: !root.preview-running && !root.face-check-running && !root.enrollment-active; }
                            Button { text: "Stop"; enabled: root.preview-running || (root.face-check-running && !root.reference-io-running); clicked => { root.stop-preview(); } }
                        }
                        HorizontalBox {
                            Text { text: root.enrollment-active || !root.template-present ? "1  SCAN" : "1  SCANNED"; color: root.enrollment-active || !root.template-present ? #3d70dc : Palette.foreground; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: root.person-needs-name ? "2  NAME YOUR FACE" : "2  NAME YOUR FACE"; color: root.person-needs-name ? #3d70dc : Palette.foreground; horizontal-stretch: 1; }
                            Text { text: "3  SAVE AND SET UP"; color: root.template-present && !root.person-needs-name && !root.enrollment-active ? #3d70dc : Palette.foreground; horizontal-stretch: 1; }
                        }
                        scan-panel := Rectangle {
                            height: root.height < 700px ? 180px : 220px;
                            border-radius: 16px;
                            background: #101d32;
                            clip: true;
                            Image { source: root.preview-image; width: parent.width; height: parent.height; image-fit: contain; visible: root.scan-frame-available || root.preview-running; }
                            // This oval is a positioning guide, not detected face bounds.
                            face-guide := Rectangle {
                                x: (parent.width - self.width) / 2; y: 16px;
                                height: parent.height - 52px; width: self.height * 0.87; border-radius: self.width / 2;
                                background: transparent;
                                border-width: 2px;
                                border-color: root.recognition-state == 1 ? #66e8ac : #739dff;
                                if !root.scan-frame-available && !root.preview-running: Rectangle {
                                    x: parent.width * 0.29; y: parent.height * 0.18; width: parent.width * 0.38; height: parent.height * 0.4;
                                    border-radius: 30px; border-width: 2px; border-color: #6784ac; background: transparent;
                                }
                                if !root.scan-frame-available && !root.preview-running: Rectangle {
                                    x: parent.width * 0.16; y: parent.height * 0.63; width: parent.width * 0.65; height: parent.height * 0.21;
                                    border-radius: 20px; border-width: 2px; border-color: #6784ac; background: transparent;
                                }
                            }
                            if root.face-check-running && !root.reference-io-running: Rectangle {
                                x: 20px; width: parent.width - 40px; height: 2px;
                                y: 24px + (parent.height - 65px) * mod(animation-tick(), 1600ms) / 1600ms;
                                background: #67b4ff;
                                Rectangle { y: -7px; width: parent.width; height: 16px; background: #3087e520; }
                            }
                            Text {
                                x: 16px; y: parent.height - 30px; width: parent.width - 32px; height: 22px;
                                horizontal-alignment: center; color: #d0e0ff; font-size: 12px;
                                text: root.scanning ? "SCANNING  ·  STOP TO CANCEL" : root.person-needs-name ? "SCAN COMPLETE  ·  NAME YOUR FACE BELOW" : "POSITION YOUR FACE IN THE GUIDE  ·  IMAGES ARE NOT SAVED";
                            }
                            if root.recognition-state == 1 && !root.face-check-running: Rectangle {
                                x: parent.width - 50px; y: 16px; width: 32px; height: 32px; border-radius: 16px; background: #2ab47e;
                                Text { text: "✓"; color: white; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        if root.enrollment-active: Rectangle {
                            height: 6px; border-radius: 3px; background: #d6e1f6;
                            Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * root.sample-count / root.sample-target; border-radius: 3px; background: #3d70dc; }
                        }
                        Text {
                            text: root.enrollment-active ? root.sample-instruction + " (" + root.sample-count + "/" + root.sample-target + ")" : root.person-needs-name ? "What should this face be called?" : root.recognition-state > 0 ? root.recognition-title : root.template-present ? "Ready to recognize: " + root.active-person-name : "Scan your face, then give it a name";
                            font-size: 21px; font-weight: 700; wrap: word-wrap;
                            color: root.recognition-state == 1 ? #188357 : Palette.foreground;
                        }
                        if root.person-needs-name && !root.enrollment-active: HorizontalBox {
                            LineEdit { placeholder-text: "Name or label, e.g. Alex"; text <=> root.person-name; enabled: !root.face-check-running; horizontal-stretch: 1; }
                            Button { text: "Name this face"; enabled: !root.face-check-running && root.person-name != ""; clicked => { root.rename-person(); } }
                        }
                        if !root.person-needs-name: HorizontalBox {
                            if !root.template-present || root.enrollment-active: Button {
                                text: root.scanning ? "Scanning…" : root.enrollment-active ? "Resume scan" : "Scan a new face";
                                enabled: root.face-check-available && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != "";
                                clicked => { root.scan-person(); }
                            }
                            if root.template-present && !root.enrollment-active: Button {
                                text: root.scanning ? "Recognizing…" : "Scan and recognize";
                                enabled: root.sample-count >= root.sample-target && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != "";
                                clicked => { root.recognize-face(); }
                            }
                            if root.enrollment-active: Button { text: "Cancel enrollment"; enabled: !root.face-check-running && !root.preview-running; clicked => { root.cancel-person(); } }
                            if root.template-present && !root.enrollment-active: Button { text: "Replace this face"; enabled: !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.scan-person(); } }
                            Button { text: "Save and set up"; enabled: !root.face-check-running && !root.preview-running; clicked => { root.page = 2; } }
                        }
                        if root.recognition-state != 1 && root.recognition-state != 2 && root.recognition-state != 3: Text { text: root.face-check-message; wrap: word-wrap; color: Palette.foreground; font-size: 12px; }
                    }
                }
            }
            Tab {
                title: "Settings";
                ScrollView {
                    content-width: self.width;
                    content-height: settings-content.preferred-height;
                    settings-content := VerticalBox {
                        width: parent.width;
                        height: self.preferred-height;
                    GroupBox { title: "Where should this face be used?"; VerticalBox {
                        Text { text: "Choose the uses for your account. After saving, the application runs the setup checks for you."; wrap: word-wrap; color: Palette.foreground; }
                        HorizontalBox {
                            spacing: 10px;
                            UseCard { heading: "Sudo"; description: "Authorize commands that require elevated privileges."; checked <=> root.use-for-sudo; option-enabled: !root.face-check-running; }
                            UseCard { heading: "Desktop sign-in"; description: "Sign in to your account after starting the computer."; checked <=> root.use-for-login; option-enabled: !root.face-check-running; }
                            UseCard { heading: "Screen unlock"; description: "KDE, Hyprland / Hyprlock, or Noctalia."; checked <=> root.use-for-unlock; option-enabled: !root.face-check-running; }
                        }
                        Text { text: root.system-message; wrap: word-wrap; color: root.system-configured ? #188357 : Palette.foreground; }
                    } }
                    if root.developer-mode: GroupBox { title: "Camera preview"; VerticalBox {
                        HorizontalBox {
                            Text { text: "Preview timeout (seconds)"; color: Palette.foreground; vertical-alignment: center; }
                            SpinBox { minimum: 1; maximum: 30; value <=> root.timeout-seconds; enabled: !root.preview-running && !root.face-check-running; }
                        }
                        Text { text: "Applies to this window only. No camera runs in the background."; color: Palette.foreground; wrap: word-wrap; }
                    } }
                    if root.face-check-available && root.template-present && !root.enrollment-active: GroupBox { title: "Face name"; VerticalBox {
                        Text { text: "Current name: " + root.active-person-name; color: Palette.foreground; wrap: word-wrap; }
                        HorizontalBox {
                            LineEdit { placeholder-text: "New face name"; text <=> root.person-name; enabled: !root.face-check-running; horizontal-stretch: 1; }
                            Button { text: "Rename"; enabled: !root.face-check-running && !root.preview-running && root.person-name != ""; clicked => { root.rename-person(); } }
                            Button { text: "Forget in-memory reference"; enabled: !root.face-check-running && !root.preview-running; clicked => { root.forget-face(); } }
                        }
                    } }
                    if root.face-check-available: GroupBox { title: "Save your face and complete setup"; VerticalBox {
                        Text { text: "Choose a separate encryption passphrase (at least 12 characters). Approve the system authorization dialog and keep facing the camera during the checks."; wrap: word-wrap; color: Palette.foreground; }
                        LineEdit { placeholder-text: "Reference passphrase"; input-type: password; text <=> root.reference-password; enabled: !root.face-check-running; }
                        LineEdit { placeholder-text: "Confirm passphrase when saving"; input-type: password; text <=> root.reference-password-confirm; enabled: !root.face-check-running; }
                        HorizontalBox {
                            Button { text: root.reference-io-running ? "Setting up…" : "Save and set up"; enabled: root.template-present && !root.person-needs-name && !root.enrollment-active && !root.face-check-running && !root.preview-running; clicked => { root.save-and-configure(); } }
                            if root.developer-mode: Button { text: "Save locally only"; enabled: root.template-present && !root.enrollment-active && !root.face-check-running && !root.preview-running; clicked => { root.save-reference(); } }
                            Button { text: "Load reference"; enabled: !root.face-check-running && !root.preview-running; clicked => { root.load-reference(); } }
                            Button { text: "Delete local reference file"; enabled: !root.face-check-running && !root.preview-running; clicked => { root.delete-reference(); } }
                        }
                        Text { text: root.storage-message; wrap: word-wrap; color: Palette.foreground; }
                        Text { text: "The reference passphrase protects your local copy. It is separate from the account password. Load it after restarting; system authentication uses a separate protected reference."; wrap: word-wrap; color: Palette.foreground; }
                    } }
                    if root.face-check-available && root.developer-mode: GroupBox { title: "Recognition threshold"; VerticalBox {
                        HorizontalBox {
                            Text { text: "Similarity threshold (0.80–1.00)"; color: Palette.foreground; }
                            LineEdit { text <=> root.recognition-threshold; enabled: !root.face-check-running; horizontal-stretch: 1; }
                        }
                        Text { text: "Three fresh matching frames, centroid, saved examples and face proportions. Minimum threshold 0.80; no validated PAD. This setting applies to GUI tests, not PAM."; wrap: word-wrap; color: Palette.foreground; }
                    } }
                    if root.face-check-available && root.developer-mode: GroupBox { title: "Recognition trials"; VerticalBox {
                        Text { text: "Select the camera/IR mode in Camera first. Choose Saved person for the reference owner, Other person for someone else with their consent. Each click checks 3 fresh captures."; wrap: word-wrap; color: Palette.foreground; }
                        HorizontalBox {
                            Button { text: "Test saved person"; enabled: root.template-present && root.sample-count >= root.sample-target && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.test-saved-person(); } }
                            Button { text: "Test other person"; enabled: root.template-present && root.sample-count >= root.sample-target && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.test-other-person(); } }
                            Button { text: "Clear trials"; enabled: !root.face-check-running; clicked => { root.clear-trials(); } }
                            Button { text: "Stop"; enabled: root.face-check-running && !root.reference-io-running; clicked => { root.stop-preview(); } }
                        }
                        Text { text: root.trial-message; wrap: word-wrap; color: Palette.foreground; }
                        Text { text: "Counts stay in memory until Clear trials or window close. Labels are declared by you. Inconclusive and acquisition failures stay separate; cancellation is not counted. Clear trials after changing reference or threshold. No calibrated accuracy or login authorization."; wrap: word-wrap; color: Palette.foreground; }
                    } }
                    if root.face-check-available && root.developer-mode: GroupBox { title: "Camera and model diagnostics"; VerticalBox {
                        LineEdit { placeholder-text: "Local model directory"; text <=> root.models-directory; enabled: !root.face-check-running && !root.enrollment-active; }
                        HorizontalBox {
                            Button { text: "Check face"; enabled: !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.check-face(); } }
                            Button { text: "Compare 3 samples"; enabled: root.reference-present && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.compare-three(); } }
                            Button { text: "Remember face"; enabled: !root.face-check-running && !root.preview-running && !root.enrollment-active && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.remember-face(); } }
                        }
                        Button { text: "Head movement test (diagnostics)"; enabled: root.template-present && !root.face-check-running && !root.preview-running && !root.refreshing && root.devices.length > 0 && root.models-directory != ""; clicked => { root.test-motion(); } }
                    } }
                    GroupBox { title: "Manage system face authentication"; VerticalBox {
                        Text { text: root.account-status; wrap: word-wrap; color: Palette.foreground; }
                        Text { text: "These controls affect only your system account. Pausing keeps the protected reference. Removing deletes it; the encrypted local GUI reference is retained. System authorization is required."; wrap: word-wrap; color: Palette.foreground; }
                        HorizontalBox {
                            Button { text: "Check status"; enabled: root.system-controls-available && !root.face-check-running && !root.preview-running; clicked => { root.refresh-account-status(); } }
                            Button { text: "Pause face authentication"; enabled: root.system-controls-available && !root.face-check-running && !root.preview-running; clicked => { root.pause-account(); } }
                        }
                        CheckBox { text: "I want to remove my protected system face reference"; checked <=> root.confirm-system-removal; enabled: !root.face-check-running; }
                        Button { text: "Remove system reference"; enabled: root.system-controls-available && root.confirm-system-removal && !root.face-check-running && !root.preview-running; clicked => { root.remove-account(); } }
                    } }
                    CheckBox { text: "Developer mode — diagnostics and advanced settings"; checked <=> root.developer-mode; enabled: !root.face-check-running; }
                    if root.developer-mode: CheckBox { text: "Diagnostic session D-Bus"; checked <=> root.session-bus; enabled: !root.refreshing; }
                }
                }
            }
            Tab {
                title: "Security";
                VerticalBox {
                    Text { text: "Privacy and security"; font-size: 22px; font-weight: 600; color: Palette.foreground; }
                    Text { text: "Your face is processed locally. Saved references are encrypted, and the system reference is protected from ordinary applications.\n\nYour account password remains available. Photo/video attack protection is not validated. IR is not proof of liveness. Optional TPM protects the key without boot-state attestation."; color: Palette.foreground; wrap: word-wrap; }
                    Text { text: "Deleting the local file does not remove the protected system reference. Use account controls to pause or remove system face authentication."; color: Palette.foreground; wrap: word-wrap; }
                }
            }
            Tab {
                title: root.developer-mode ? "Diagnostics" : "Help";
                VerticalBox {
                    Button { text: "Run installation health check"; enabled: root.health-check-available && !root.face-check-running && !root.preview-running; clicked => { root.run-health-check(); } }
                    TextEdit { text: root.diagnostics; read-only: true; }
                    if !root.developer-mode: Text { text: "1. Enroll your face in the Face tab.\n2. Give it a name.\n3. Choose uses and select Save and set up.\n\nLook straight at the camera during checks. At sign-in, select your account and submit the empty password field. After Win + L, show the unlock screen. Use your password if recognition fails."; wrap: word-wrap; color: Palette.foreground; }
                }
            }
        }
        Text { text: root.developer-mode ? "0.1.0-dev · Developer mode · Diagnostics cannot bypass authentication" : "Linux Hello · Your data stays on this computer"; color: Palette.foreground; font-size: 12px; }
    }
}
